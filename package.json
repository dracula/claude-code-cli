{
  "name": "claude-code-cli",
  "private": true,
  "description": "Dracula theme for the Claude Code CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dracula/claude-code-cli.git"
  },
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "release": "release-it"
  },
  "devDependencies": {
    "oxfmt": "^0.71.0",
    "release-it": "^19.2.4"
  },
  "release-it": {
    "git": {
      "requireBranch": "main",
      "commit": false,
      "tagName": "${version}"
    },
    "github": {
      "release": true,
      "web": true,
      "releaseName": "${version}",
      "autoGenerate": true
    },
    "npm": false
  }
}
